# Local development. Docker Compose explicitly sets production mode.
HOST=127.0.0.1
PORT=3001
TRUST_PROXY=loopback

# Optional SQLite persistence for unexpired demo sessions.
# Leave blank for memory-only local development; Compose uses /app/data.
DATA_DIR=

# Optional live AI. Leave blank for the complete deterministic demo.
# Never use a VITE_ prefix for a secret: Vite exposes those to the browser.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Public deployment: use the exact https:// hostname, without a trailing slash.
PUBLIC_ORIGIN=
# Optional dedicated bearer token for server-to-server automation.
N8N_API_TOKEN=

# Caddy: set your chosen DuckDNS/custom hostname before a public launch.
# http://localhost supports local Docker preview without certificate setup.
SITE_ADDRESS=http://localhost
HTTP_PORT=8080
HTTPS_PORT=8443
APP_PORT=3001
