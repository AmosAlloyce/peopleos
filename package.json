{
  "name": "peopleos-portfolio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:client": "vite --host 127.0.0.1",
    "dev:server": "node --env-file-if-exists=.env server/index.mjs",
    "build": "vite build",
    "start": "node --env-file-if-exists=.env server/index.mjs",
    "test": "node --test test/*.test.mjs",
    "test:browser": "node scripts/browser-test.mjs",
    "test:portfolio": "node scripts/portfolio-test.mjs",
    "record:demo": "node scripts/record-demo.mjs",
    "format": "prettier --write \"src/**/*.{js,jsx,css}\" \"server/*.mjs\" \"scripts/*.mjs\" \"test/*.mjs\""
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.7.0",
    "express": "^5.1.0",
    "lucide-react": "^0.468.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "vite": "^6.3.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "prettier": "^3.9.9"
  }
}
